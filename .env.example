# Frontend environment example for local development
# Copy this file to .env and fill in values before running the app.
VITE_API_BASE_URL=http://localhost:4000/api
VITE_APP_NAME=MegaMart Commerce
VITE_DEFAULT_LOCALE=en-US
VITE_DEFAULT_CURRENCY=USD
# Optional: public payment keys for storefront widgets
# VITE_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
